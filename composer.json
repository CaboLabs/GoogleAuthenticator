{
    "name": "cabolabs/google-authenticator",
    "description": "Library to integrate Google Authenticator into a PHP project",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "google authenticator"
    ],
    "homepage": "https://github.com/CaboLabs/GoogleAuthenticator/",
    "require": {
        "php": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "symfony/phpunit-bridge": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Google\\Authenticator\\": "src/",
            "CaboLabs\\GoogleAuthenticator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Google\\Authenticator\\Tests\\": "tests/",
            "Sonata\\GoogleAuthenticator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
